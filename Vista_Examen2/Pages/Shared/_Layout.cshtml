<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Gestión de Tesis</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var usuario = Context.Session.GetString("UsuarioLogueado");
        bool estaLogueado = !string.IsNullOrEmpty(usuario);
    }

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-magenta shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-page="/Tesis/Index">🎓 Repositorio de Tesis</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-page="/Tesis/Index">Tesis y Búsqueda</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white fw-semibold" asp-page="/Tutores/Index">Tutores</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (estaLogueado)
                        {
                            <li class="nav-item text-white me-3 small fw-semibold">👤 @usuario</li>
                            <li class="nav-item">
                                <a class="btn btn-sm btn-light text-magenta fw-bold" asp-page="/Auth/Login" asp-route-logout="true">Cerrar Sesión</a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn btn-sm btn-light text-magenta fw-bold" asp-page="/Auth/Login">Iniciar Sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="pb-4">
        @RenderBody()
    </main>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>